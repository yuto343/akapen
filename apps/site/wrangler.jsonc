{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "akapen-site",
  // SvelteKit（@sveltejs/adapter-cloudflare）が書き出す Worker。ページは prerender した HTML を配る。
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "routes": [
    {
      "pattern": "akapen.yuto343.net",
      "custom_domain": true
    }
  ],
  // workers.dev の URL では出さない（akapen.yuto343.net だけにする）。
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
