{
  "title": "env.contract.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["surfaces"],
  "properties": {
    "$schema": { "type": "string" },
    "surfaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["envs"],
        "properties": {
          "kind": { "type": "string", "enum": ["convex"] },
          "version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": {
              "source": { "type": "string", "pattern": "^[^#]+#[^#]+$" },
              "copies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[^#]+#[^#]+$" } },
              "ignore": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[^#]+$" } }
            }
          },
          "envs": {
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["local", "dev", "production"] },
            "required": ["local", "dev", "production"],
            "additionalProperties": {
              "additionalProperties": false,
              "properties": {
                "identifier": { "type": "string", "pattern": "^\\S+$" },
                "backend": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "updater": { "pattern": "^\\S+$" },
                "urls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^https?://[^/\\s]+$" } },
                "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[^#]+(#[^#]+)?$" } }
              }
            }
          }
        }
      }
    }
  }
}
